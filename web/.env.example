# ClubPal Web — Environment Variables
# In production these are served via Nginx (relative paths, no env vars needed)
# In development, override to point at local backend directly

VITE_GATEWAY_URL=http://localhost:8001

# Google OIDC — must match the Web Client ID in Google Cloud Console
# The same client ID used by the backend GOOGLE_CLIENT_ID
VITE_GOOGLE_CLIENT_ID=
VITE_GROUPS_URL=http://localhost:8002
VITE_EVENTS_URL=http://localhost:8003
VITE_RATINGS_URL=http://localhost:8004
VITE_ACTIVITIES_URL=http://localhost:8005
