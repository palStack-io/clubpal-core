# ClubPal Core — Environment Variables
# Copy this file to .env and fill in values before running `docker compose up`.
# All defaults work for local development out of the box.

# ─────────────────────────────────────────────────────────────────────────────
# Production image pull (docker-compose.prod.yml only)
# ─────────────────────────────────────────────────────────────────────────────
# GitHub username or org that owns the ghcr.io packages
GHCR_OWNER=your-github-username

# Image tag to deploy — defaults to "latest" if not set
# IMAGE_TAG=abc1234

# Host port the app listens on — defaults to 9000
# APP_PORT=9000

# ─────────────────────────────────────────────────────────────────────────────
# PostgreSQL
# ─────────────────────────────────────────────────────────────────────────────
# The password for the shared `clubpal` Postgres user.
# The database host and port are fixed inside Docker (db:5432).
POSTGRES_PASSWORD=clubpal          # Change in production

# ─────────────────────────────────────────────────────────────────────────────
# Object Storage (local filesystem, shared Docker volume — avatars, event/group cover images)
# ─────────────────────────────────────────────────────────────────────────────
# Public base URL that browsers use to load uploaded files.
# Must be reachable by end users — for production set to your domain:
#   STORAGE_PUBLIC_URL=https://yourdomain.com/storage
STORAGE_PUBLIC_URL=http://localhost:9000/storage

# ─────────────────────────────────────────────────────────────────────────────
# Email / SMTP (api-gateway)
# Leave SMTP_USER and SMTP_PASSWORD blank to disable email delivery entirely.
# The app works without email — users just won't receive verification/reset mails.
# ─────────────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=                            # e.g. your-address@gmail.com
SMTP_PASSWORD=                        # Gmail: use an App Password, not your account password
FROM_EMAIL=noreply@clubpal.app
FROM_NAME=clubPal

# ─────────────────────────────────────────────────────────────────────────────
# App URL (api-gateway — used in email links)
# ─────────────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:9000    # Change to your public domain in production

# ─────────────────────────────────────────────────────────────────────────────
# Internal service secret
# Shared between api-gateway and enrichment-service to protect the internal
# /internal/integrations endpoint (used to sync admin-stored API keys).
# Set this to any long random string. Generate one with:
#   openssl rand -hex 32
# If left blank the endpoint still works but is unprotected (fine for LAN-only
# deployments, not recommended when exposed to the internet).
# ─────────────────────────────────────────────────────────────────────────────
INTERNAL_API_SECRET=                  # Recommended: set a strong random value

# ─────────────────────────────────────────────────────────────────────────────
# Enrichment Service — External API Keys (all optional)
# Without these keys the enrichment service starts fine; search features that
# depend on each API will return empty results rather than errors.
# ─────────────────────────────────────────────────────────────────────────────

# Google Cloud API key — enables: restaurant/venue search (Places API),
# book search (Books API), geocoding.
# Create at: https://console.cloud.google.com/ → APIs & Services → Credentials
# Enable: Places API (New), Books API, Geocoding API
GOOGLE_API_KEY=

# The Movie Database — enables: movie/TV search and metadata.
# Free tier available. Create at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# IGDB (Twitch) — enables: video game search and metadata.
# Requires a free Twitch developer account: https://dev.twitch.tv/console
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Enrichment cache TTLs (seconds) — optional, defaults shown
# CACHE_TTL_SEARCH=86400      # 24 hours — search result pages
# CACHE_TTL_DETAIL=604800     # 7 days  — individual item detail
# CACHE_TTL_GEOCODE=2592000   # 30 days — geocode results

# ─────────────────────────────────────────────────────────────────────────────
# Bill Split Service — Google Cloud Vision (receipt OCR)
# Without this key the bill-split service starts fine; receipt scanning is
# disabled and users can enter items manually instead.
# Manage via Admin panel (admin users only) → Admin > Integrations.
# Or set here as a fallback — the DB value takes precedence if both are set.
# Create at: https://console.cloud.google.com/ → APIs & Services → Credentials
# Enable: Cloud Vision API
# ─────────────────────────────────────────────────────────────────────────────
GOOGLE_CLOUD_VISION_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Backup Service
# Runs as a Docker service — no cron or rclone needed on the host.
# ─────────────────────────────────────────────────────────────────────────────

# Cron schedules (default: postgres at 03:00, storage at 04:00 UTC)
BACKUP_PG_SCHEDULE=0 3 * * *
BACKUP_STORAGE_SCHEDULE=0 4 * * *

# How many days to keep local backup files on the server
BACKUP_PG_RETENTION_DAYS=14
BACKUP_STORAGE_RETENTION_DAYS=7

# ── Remote storage ────────────────────────────────────────────────────────────
# Leave BACKUP_REMOTE_BUCKET empty to disable remote upload (local only).
BACKUP_REMOTE_BUCKET=

# Option A — Backblaze B2 (recommended: $0.006/GB, free egress via Cloudflare)
#   Create a bucket + application key at: https://www.backblaze.com/b2/cloud-storage.html
RCLONE_CONFIG_REMOTE_TYPE=b2
RCLONE_CONFIG_REMOTE_ACCOUNT=
RCLONE_CONFIG_REMOTE_KEY=

# Option B — Cloudflare R2 (zero egress fees, S3-compatible)
#   Comment out B2 vars above and uncomment these:
# RCLONE_CONFIG_REMOTE_TYPE=s3
# RCLONE_CONFIG_REMOTE_PROVIDER=Cloudflare
# RCLONE_CONFIG_REMOTE_ACCESS_KEY_ID=
# RCLONE_CONFIG_REMOTE_SECRET_ACCESS_KEY=
# RCLONE_CONFIG_REMOTE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# RCLONE_CONFIG_REMOTE_REGION=auto

# Option C — AWS S3
# RCLONE_CONFIG_REMOTE_TYPE=s3
# RCLONE_CONFIG_REMOTE_PROVIDER=AWS
# RCLONE_CONFIG_REMOTE_ACCESS_KEY_ID=
# RCLONE_CONFIG_REMOTE_SECRET_ACCESS_KEY=
# RCLONE_CONFIG_REMOTE_REGION=us-east-1

# ── Dead man's switch (optional) ──────────────────────────────────────────────
# Ping a URL after each successful backup. Free tier at healthchecks.io.
BACKUP_HEALTHCHECK_URL=
