# ──────────────────────────────────────────────────────────────────────────────
# clubPal — a palStack.io product
# Copy this file to .env and fill in the values you need.
# Omitted / blank values fall back to the defaults shown in docker-compose.yml.
# ──────────────────────────────────────────────────────────────────────────────


# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Leave SMTP_USER and SMTP_PASSWORD blank to disable email sending entirely.
# Emails will be logged to the api-gateway console instead (great for dev).
#
# Gmail example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=you@gmail.com
#   SMTP_PASSWORD=<16-char app password from Google account>
#
# Other providers: Mailgun, SendGrid, Postmark, Brevo, etc. all support SMTP.
# For production, set FROM_EMAIL to a domain you own (e.g. noreply@palstack.io).

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@palstack.io
FROM_NAME=clubPal


# ── App URL ───────────────────────────────────────────────────────────────────
# Used to build links inside emails (invite, verification, password reset, etc.)
# Set to your public domain in production.

FRONTEND_URL=http://localhost:9000


# ── MinIO / Object Storage ────────────────────────────────────────────────────
# Change credentials from the defaults before deploying to production.

MINIO_ROOT_USER=clubpal
MINIO_ROOT_PASSWORD=clubpalpassword

# Public URL through which browsers download images (via nginx proxy).
# In production: https://yourdomain.com/storage
MINIO_PUBLIC_URL=http://localhost:9000/storage


# ── Database ──────────────────────────────────────────────────────────────────
# Managed by Docker Compose. Override only if using an external Postgres.
# DATABASE_URL=postgresql://clubpal:clubpal@localhost:5432/clubpal_gateway


# ── External API Keys (Enrichment Service) ───────────────────────────────────
# These can also be set from the admin panel: Settings → Integrations.
# Env vars here take precedence over values stored via the UI.
#
# Google Cloud — enables place search, nearby, geocoding, books
# Create a key at: https://console.cloud.google.com/apis/credentials
# Required APIs: Places API (New), Maps Geocoding API, Books API
GOOGLE_API_KEY=

# TMDB — movie search and discovery
# Get a free key at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# IGDB (via Twitch) — video game search and discovery
# Register an app at: https://dev.twitch.tv/console/apps
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
